<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TypeScript.Compiler</RootNamespace>
    <!-- 目前只有 Core/IcuCaseFolding.cs 用到：那里的入口点是 delegate* unmanaged[Cdecl] 函数指针，
         而不是被 marshaller 包装过的委托（见该文件与 docs/architecture.md §10.2）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/Gen 生成的定形 create*/update*（见 docs/architecture.md §15.7）。生成物入库并由
         GeneratedTablesTests 与 TS 源逐字节比对，所以这里不需要额外的开关。 -->
  </ItemGroup>

</Project>
