<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TypeScript.Compiler</RootNamespace>
    <!-- 目前只有 Core/IcuCaseFolding.cs 用到：那里的入口点是 delegate* unmanaged[Cdecl] 函数指针，
         而不是被 marshaller 包装过的委托（见该文件与 docs/architecture.md §10.2）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/Gen 生成的定形 create*/update*（264 个）。它引用一批还没手写的成员 —— as* 辅助、Parenthesizer、
         以及生成器跳过的 create*（有真逻辑的那些）—— 所以在补齐之前不参与编译。补完后删掉这一项即可
         （docs/architecture.md §15.7）。生成物本身仍然提交入库，GeneratedTablesTests 照常比对它。 -->
    <Compile Remove="Parser/NodeFactory.Generated.cs" />
  </ItemGroup>

</Project>
