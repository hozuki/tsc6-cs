<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TypeScript.Compiler</RootNamespace>
    <!-- 目前只有 Core/IcuCaseFolding.cs 用到：那里的入口点是 delegate* unmanaged[Cdecl] 函数指针，
         而不是被 marshaller 包装过的委托（见该文件与 docs/architecture.md §10.2）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/Gen 生成的定形 create*/update*（见 docs/architecture.md §15.7）。生成物入库并由
         GeneratedTablesTests 与 TS 源逐字节比对，所以这里不需要额外的开关。 -->
  </ItemGroup>

  <ItemGroup>
    <!-- tools/AstDiff（§7 的 P1a 差分装置）与 tools/BindDiff（绑定/流图差分，M5）直接调用 internal 的
         Parser / Binder / ForEachChildTable / 节点模型；tools/TypeDiff（检查器差分，M6）与 tools/EmitDiff
         （发射差分，§17.5）同样直接调用 internal 的 Program / Checker / 类型与符号模型。授权方式与测试项目
         一致（见 AssemblyInfo.cs）。 -->
    <InternalsVisibleTo Include="AstDiff" />
    <InternalsVisibleTo Include="BindDiff" />
    <InternalsVisibleTo Include="TypeDiff" />
    <InternalsVisibleTo Include="EmitDiff" />
  </ItemGroup>

</Project>
